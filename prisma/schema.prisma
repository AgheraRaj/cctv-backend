generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  VIEWER
}

enum NVRType {
  HIKVISION
  HIFOCUS
}

enum NVRStatus {
  ONLINE
  OFFLINE
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      Role     @default(VIEWER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Station {
  id        String   @id @default(cuid())
  name      String
  city      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nvrs      NVR[]
  @@unique([name, city])
}

model NVR {
  id           String    @id @default(cuid())
  stationId    String
  station      Station   @relation(fields: [stationId], references: [id], onDelete: Cascade)

  type         NVRType
  name         String
  ip           String
  rtspPort     Int       @default(554)
  httpPort     Int       @default(80)
  username     String
  password     String    // AES-256 encrypted

  status       NVRStatus @default(OFFLINE)
  lastSeenAt   DateTime?
  offlineSince DateTime?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  cameras      Camera[]
}

model Camera {
  id           String    @id @default(cuid())
  nvrId        String
  nvr          NVR       @relation(fields: [nvrId], references: [id], onDelete: Cascade)

  channel      Int
  name         String
  areaTag      String?
  isActive     Boolean   @default(true)

  isOnline     Boolean   @default(false)
  lastSeenAt   DateTime?
  offlineSince DateTime?
  protocol     String?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  recordings   Recording[]

  @@unique([nvrId, channel])
}

// Recording index — metadata only, no local files.
// Actual footage lives on the NVR HDD. This table is a cache of what
// the NVR has recorded, used to answer "what's available on date X?"
// without making a live ONVIF/ISAPI query every time.
model Recording {
  id             String    @id @default(cuid())
  cameraId       String
  camera         Camera    @relation(fields: [cameraId], references: [id], onDelete: Cascade)

  nvrId          String
  channel        Int

  // ONVIF recording token (e.g. "Record_1_0") — used by GetReplayUri
  recordingToken String?

  startTime      DateTime
  endTime        DateTime?   // null while recording is ongoing
  isOngoing      Boolean     @default(false)

  createdAt      DateTime    @default(now())

  @@index([nvrId, channel, startTime, endTime])
  @@index([startTime])
}
